{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/munim/aem-log-viewer/schema/aemlog-v1.json",
  "title": "aemlog-v1",
  "description": "Closed version-1 NDJSON event envelope for aemlog --json.",
  "oneOf": [
    { "$ref": "#/$defs/session_started" },
    { "$ref": "#/$defs/group_created" },
    { "$ref": "#/$defs/group_updated" },
    { "$ref": "#/$defs/group_merged" },
    { "$ref": "#/$defs/parser_error" },
    { "$ref": "#/$defs/source_ended" }
  ],
  "$defs": {
    "version": { "type": "integer", "const": 1 },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "utc_millis": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "group_id": { "type": "integer", "minimum": 1 },
    "count": { "type": "integer", "minimum": 0 },
    "rate": { "type": "number", "minimum": 0, "maximum": 1000000 },
    "level": {
      "type": "string",
      "enum": ["TRACE", "DEBUG", "INFO", "WARN", "ERROR", "FATAL"]
    },
    "source_offset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "integer", "minimum": 0 },
        "end": { "type": "integer", "minimum": 0 }
      }
    },
    "source_offsets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp", "node", "level", "thread", "logger", "message"],
      "properties": {
        "timestamp": { "$ref": "#/$defs/source_offset" },
        "node": { "$ref": "#/$defs/source_offset" },
        "level": { "$ref": "#/$defs/source_offset" },
        "thread": { "$ref": "#/$defs/source_offset" },
        "logger": { "$ref": "#/$defs/source_offset" },
        "message": { "$ref": "#/$defs/source_offset" }
      }
    },
    "request_context": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["client_ip", "request_id", "method", "path", "protocol"],
      "properties": {
        "client_ip": { "type": "string" },
        "request_id": { "type": "string" },
        "method": { "type": "string" },
        "path": { "type": "string" },
        "protocol": { "type": "string" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["program_id", "environment_id", "service", "log"],
      "properties": {
        "program_id": { "type": "string", "minLength": 1 },
        "environment_id": { "type": "string", "minLength": 1 },
        "service": { "type": "string", "enum": ["author", "publish"] },
        "log": { "type": "string", "const": "aemerror" },
        "ims_context": { "type": "string", "minLength": 1 }
      }
    },
    "session_started": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "type",
        "session_id",
        "emitted_at",
        "source",
        "levels"
      ],
      "properties": {
        "version": { "$ref": "#/$defs/version" },
        "type": { "type": "string", "const": "session_started" },
        "session_id": { "$ref": "#/$defs/session_id" },
        "emitted_at": { "$ref": "#/$defs/utc_millis" },
        "source": { "$ref": "#/$defs/source" },
        "levels": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/level" }
        }
      }
    },
    "group_created": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "type",
        "session_id",
        "emitted_at",
        "group_id",
        "count",
        "first_seen",
        "last_seen",
        "template",
        "nodes",
        "muted",
        "level",
        "sample",
        "sample_truncated",
        "fast_rate",
        "baseline_rate",
        "timestamp",
        "node",
        "thread",
        "logger",
        "message",
        "request_context",
        "terminal_exception",
        "terminal_frame",
        "source_offsets"
      ],
      "properties": {
        "version": { "$ref": "#/$defs/version" },
        "type": { "type": "string", "const": "group_created" },
        "session_id": { "$ref": "#/$defs/session_id" },
        "emitted_at": { "$ref": "#/$defs/utc_millis" },
        "group_id": { "$ref": "#/$defs/group_id" },
        "count": { "$ref": "#/$defs/count" },
        "first_seen": { "$ref": "#/$defs/utc_millis" },
        "last_seen": { "$ref": "#/$defs/utc_millis" },
        "template": { "type": "string" },
        "nodes": { "type": "array", "items": { "type": "string" } },
        "muted": { "type": "boolean" },
        "level": { "$ref": "#/$defs/level" },
        "sample": { "type": "string" },
        "sample_truncated": { "type": "boolean" },
        "fast_rate": { "$ref": "#/$defs/rate" },
        "baseline_rate": { "$ref": "#/$defs/rate" },
        "timestamp": { "$ref": "#/$defs/utc_millis" },
        "time_fallback": { "type": "boolean" },
        "node": { "type": "string" },
        "thread": { "type": "string" },
        "logger": { "type": "string" },
        "message": { "type": "string" },
        "request_context": { "$ref": "#/$defs/request_context" },
        "terminal_exception": { "type": ["string", "null"] },
        "terminal_frame": { "type": ["string", "null"] },
        "source_offsets": { "$ref": "#/$defs/source_offsets" }
      }
    },
    "group_updated": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "type",
        "session_id",
        "emitted_at",
        "group_id",
        "count",
        "first_seen",
        "last_seen",
        "template",
        "nodes",
        "muted",
        "level",
        "fast_rate",
        "baseline_rate"
      ],
      "properties": {
        "version": { "$ref": "#/$defs/version" },
        "type": { "type": "string", "const": "group_updated" },
        "session_id": { "$ref": "#/$defs/session_id" },
        "emitted_at": { "$ref": "#/$defs/utc_millis" },
        "group_id": { "$ref": "#/$defs/group_id" },
        "count": { "$ref": "#/$defs/count" },
        "first_seen": { "$ref": "#/$defs/utc_millis" },
        "last_seen": { "$ref": "#/$defs/utc_millis" },
        "template": { "type": "string" },
        "nodes": { "type": "array", "items": { "type": "string" } },
        "muted": { "type": "boolean" },
        "level": { "$ref": "#/$defs/level" },
        "fast_rate": { "$ref": "#/$defs/rate" },
        "baseline_rate": { "$ref": "#/$defs/rate" }
      }
    },
    "group_merged": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "type",
        "session_id",
        "emitted_at",
        "group_id",
        "removed_id",
        "count",
        "first_seen",
        "last_seen",
        "template",
        "nodes",
        "muted",
        "level",
        "sample",
        "sample_truncated",
        "fast_rate",
        "baseline_rate"
      ],
      "properties": {
        "version": { "$ref": "#/$defs/version" },
        "type": { "type": "string", "const": "group_merged" },
        "session_id": { "$ref": "#/$defs/session_id" },
        "emitted_at": { "$ref": "#/$defs/utc_millis" },
        "group_id": { "$ref": "#/$defs/group_id" },
        "removed_id": { "$ref": "#/$defs/group_id" },
        "count": { "$ref": "#/$defs/count" },
        "first_seen": { "$ref": "#/$defs/utc_millis" },
        "last_seen": { "$ref": "#/$defs/utc_millis" },
        "template": { "type": "string" },
        "nodes": { "type": "array", "items": { "type": "string" } },
        "muted": { "type": "boolean" },
        "level": { "$ref": "#/$defs/level" },
        "sample": { "type": "string" },
        "sample_truncated": { "type": "boolean" },
        "fast_rate": { "$ref": "#/$defs/rate" },
        "baseline_rate": { "$ref": "#/$defs/rate" }
      }
    },
    "parser_error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "type",
        "session_id",
        "emitted_at",
        "reason",
        "count",
        "sample",
        "sample_truncated",
        "line",
        "offset"
      ],
      "properties": {
        "version": { "$ref": "#/$defs/version" },
        "type": { "type": "string", "const": "parser_error" },
        "session_id": { "$ref": "#/$defs/session_id" },
        "emitted_at": { "$ref": "#/$defs/utc_millis" },
        "reason": {
          "type": "string",
          "enum": [
            "event_byte_limit",
            "event_line_limit",
            "unframed_prefix",
            "unframed_late",
            "invalid_utf8"
          ]
        },
        "count": { "$ref": "#/$defs/count" },
        "sample": { "type": "string" },
        "sample_truncated": { "type": "boolean" },
        "line": { "type": "integer", "minimum": 0 },
        "offset": { "type": "integer", "minimum": 0 }
      }
    },
    "source_ended": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "type",
        "session_id",
        "emitted_at",
        "status",
        "stderr",
        "stderr_truncated"
      ],
      "properties": {
        "version": { "$ref": "#/$defs/version" },
        "type": { "type": "string", "const": "source_ended" },
        "session_id": { "$ref": "#/$defs/session_id" },
        "emitted_at": { "$ref": "#/$defs/utc_millis" },
        "status": { "type": ["integer", "null"] },
        "stderr": { "type": "string" },
        "stderr_truncated": { "type": "boolean" }
      }
    }
  }
}
